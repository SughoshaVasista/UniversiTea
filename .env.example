# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/universitea?schema=public"

# NextAuth Authentication & Session Security
NEXTAUTH_SECRET="generate-a-random-32-character-secret-here"
NEXTAUTH_URL="http://localhost:3000"
SESSION_SECRET="generate-a-random-session-secret"

# Application Base URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email / OTP Delivery Config
EMAIL_FROM="noreply@universitea.com"
RESEND_API_KEY=""

# Object Storage Credentials (Receipts / Attachments)
STORAGE_PROVIDER="local" # "local" or "s3" or "gcs"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Redis Pub/Sub, Socket.IO adapter, cache & rate limiting (required for realtime)
REDIS_URL="redis://localhost:6379"

# AI Provider Configuration (Phase 10)
# Options: "mock" (default), "gemini", "openai"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# WebSockets / Realtime Server URL
REALTIME_URL="http://localhost:3000"
NEXT_PUBLIC_REALTIME_URL="http://localhost:3000"
